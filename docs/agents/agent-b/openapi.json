  "components": {
    "schemas": {
      "AgentEvent": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          },
          "at": {
            "type": "integer",
            "title": "At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "kind",
          "payload",
          "at"
        ],
        "title": "AgentEvent"
      },
      "Ask": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 1200,
            "minLength": 1,
            "title": "Text"
          },
          "orderId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Orderid"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text"
        ],
        "title": "Ask"
      },
      "Cancel": {
        "properties": {
          "signature": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{130}$",
            "title": "Signature"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "signature"
        ],
        "title": "Cancel"
      },
      "Comparison": {
        "properties": {
          "blockHash": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$",
            "title": "Blockhash"
          },
          "blockNumber": {
            "type": "string",
            "maxLength": 78,
            "pattern": "^(0|[1-9][0-9]*)$",
            "title": "Blocknumber"
          },
          "evidence": {
            "type": "string",
            "enum": [
              "OBSERVED_MAINNET",
              "EXECUTED_MAINNET",
              "FORK_SIMULATION",
              "BACKTEST",
              "SYNTHETIC",
              "UNVERIFIED"
            ],
            "title": "Evidence"
          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/ExecutionCandidate"
            },
            "type": "array",
            "title": "Candidates"
          },
          "selected": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExecutionCandidate"
              },
              {
                "type": "null"
              }
            ]
          },
          "combinationsChecked": {
            "type": "integer",
            "title": "Combinationschecked"
          },
          "truncated": {
            "type": "boolean",
            "title": "Truncated"
          },
          "globalOptimum": {
            "type": "boolean",
            "title": "Globaloptimum"
          },
          "smallestEconomicFillTested": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 78,
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Smallesteconomicfilltested"
          },
          "marketEvidence": {
            "type": "string",
            "enum": [
              "OBSERVED_MAINNET",
              "EXECUTED_MAINNET",
              "FORK_SIMULATION",
              "BACKTEST",
              "SYNTHETIC",
              "UNVERIFIED"
            ],
            "title": "Marketevidence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "blockHash",
          "blockNumber",
          "evidence",
          "candidates",
          "selected",
          "combinationsChecked",
          "truncated",
          "globalOptimum",
          "smallestEconomicFillTested",
          "marketEvidence"
        ],
        "title": "Comparison"
      },
      "CostBreakdown": {
        "properties": {
          "dex_lower": {
            "type": "string",
            "maxLength": 78,
            "pattern": "^(0|[1-9][0-9]*)$",
            "title": "Dex Lower"
          },
          "l1": {
            "type": "string",
            "maxLength": 78,
            "pattern": "^(0|[1-9][0-9]*)$",
            "title": "L1"
          },
          "l2": {
            "type": "string",
            "maxLength": 78,
            "pattern": "^(0|[1-9][0-9]*)$",
            "title": "L2"
          },
          "settlement": {
            "type": "string",
            "maxLength": 78,
            "pattern": "^(0|[1-9][0-9]*)$",
            "title": "Settlement"
          },
          "verification": {
            "type": "string",
            "maxLength": 78,
            "pattern": "^(0|[1-9][0-9]*)$",
            "title": "Verification"
          },
          "approval": {
            "type": "string",
            "maxLength": 78,
            "pattern": "^(0|[1-9][0-9]*)$",
            "title": "Approval"
          },
          "service": {
            "type": "string",
            "maxLength": 78,
            "pattern": "^(0|[1-9][0-9]*)$",
            "title": "Service"
          },
          "other": {
            "type": "string",
            "maxLength": 78,
            "pattern": "^(0|[1-9][0-9]*)$",
            "title": "Other"
          },
          "margin": {
            "type": "string",
            "maxLength": 78,
            "pattern": "^(0|[1-9][0-9]*)$",
            "title": "Margin"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "dex_lower",
          "l1",
          "l2",
          "settlement",
          "verification",
          "approval",
          "service",
          "other",
          "margin"
        ],
        "title": "CostBreakdown"
      },
      "ExecutionCandidate": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "DEX_ONLY",
              "DIRECT_MATCH",
