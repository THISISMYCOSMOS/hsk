{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MarketSnapshot proposed 1.0",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "version",
        "chain_id",
        "source",
        "queried_at",
        "evidence",
        "block_number",
        "block_hash",
        "error",
        "data"
      ],
      "properties": {
        "version": {
          "const": "1.0"
        },
        "chain_id": {
          "const": 177
        },
        "source": {
          "type": "string"
        },
        "queried_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence": {
          "const": "OBSERVED_MAINNET"
        },
        "block_number": {
          "type": "integer",
          "minimum": 0
        },
        "block_hash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "error": {
          "const": null
        },
        "data": {
          "type": "object",
          "required": [
            "pool",
            "token0",
            "token1",
            "fee",
            "active_liquidity",
            "sqrt_price_x96",
            "tick"
          ],
          "properties": {
            "pool": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            "token0": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            "token1": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            "fee": {
              "type": "integer",
              "minimum": 0
            },
            "active_liquidity": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,77})$"
            },
            "sqrt_price_x96": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,77})$"
            },
            "tick": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "version",
        "chain_id",
        "source",
        "queried_at",
        "evidence",
        "block_number",
        "block_hash",
        "error",
        "data"
      ],
      "properties": {
        "version": {
          "const": "1.0"
        },
        "chain_id": {
          "const": 177
        },
        "source": {
          "type": "string"
        },
        "queried_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence": {
          "const": "UNVERIFIED"
        },
        "block_number": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "const": null
            }
          ]
        },
        "block_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{64}$"
            },
            {
              "const": null
            }
          ]
        },
        "error": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "const": null
        }
      },
      "additionalProperties": false
    }
  ]
}
