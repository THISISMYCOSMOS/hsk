{
  "type": "object",
  "properties": {
    "planId": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "executionDeadline": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,77})$",
      "description": "uint256 decimal, value <= 2^256-1"
    },
    "legs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "signedOrder": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "order",
              "signature"
            ],
            "properties": {
              "order": {
                "type": "object",
                "required": [
                  "owner",
                  "recipient",
                  "tokenIn",
                  "tokenOut",
                  "orderKind",
                  "amountIn",
                  "amountOut",
                  "validAfter",
                  "deadline",
                  "nonce",
                  "partiallyFillable",
                  "allowDexFallback",
                  "executionPriority",
                  "maxFeeAmount",
                  "minImprovementAmount",
                  "allowedExecutor",
                  "allowDex",
                  "immediate"
                ],
                "properties": {
                  "owner": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{40}$"
                  },
                  "recipient": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{40}$"
                  },
                  "tokenIn": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{40}$"
                  },
                  "tokenOut": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{40}$"
                  },
                  "orderKind": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "amountIn": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,77})$",
                    "description": "uint256 decimal, value <= 2^256-1"
                  },
                  "amountOut": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,77})$",
                    "description": "uint256 decimal, value <= 2^256-1"
                  },
                  "validAfter": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,77})$",
                    "description": "uint256 decimal, value <= 2^256-1"
                  },
                  "deadline": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,77})$",
                    "description": "uint256 decimal, value <= 2^256-1"
                  },
                  "nonce": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,77})$",
                    "description": "uint256 decimal, value <= 2^256-1"
                  },
                  "partiallyFillable": {
                    "type": "boolean"
                  },
                  "allowDexFallback": {
                    "type": "boolean"
                  },
                  "executionPriority": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "maxFeeAmount": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,77})$",
                    "description": "uint256 decimal, value <= 2^256-1"
                  },
                  "minImprovementAmount": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,77})$",
                    "description": "uint256 decimal, value <= 2^256-1"
                  },
                  "allowedExecutor": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{40}$"
                  },
                  "allowDex": {
                    "type": "boolean"
                  },
                  "immediate": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              },
              "signature": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{130}$"
              }
            }
          },
          "directWHSK": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,77})$",
            "description": "uint256 decimal, value <= 2^256-1"
          },
          "directUSDT": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,77})$",
            "description": "uint256 decimal, value <= 2^256-1"
          },
          "feeUSDT": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,77})$",
            "description": "uint256 decimal, value <= 2^256-1"
          }
        },
        "required": [
          "signedOrder",
          "directWHSK",
          "directUSDT",
          "feeUSDT"
        ],
        "additionalProperties": false
      }
    },
    "dexWHSK": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,77})$",
      "description": "uint256 decimal, value <= 2^256-1"
    },
    "dexCashLimit": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,77})$",
      "description": "uint256 decimal, value <= 2^256-1"
    },
    "tryFallback": {
      "type": "boolean"
    }
  },
  "required": [
    "planId",
    "executionDeadline",
    "legs",
    "dexWHSK",
    "dexCashLimit",
    "tryFallback"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hsk:settlement-execution-plan:1"
}
